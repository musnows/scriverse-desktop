+  if (!(button instanceof HTMLButtonElement) || !desktopWorkspaceController) return;
+  const aggregate = await desktopWorkspaceController.aggregateStatus();
+  let text = "未离线";
+  let status = "empty";
+  if (desktopInitialOfflineDownloadProgress) {
+    text = `下载中 ${desktopInitialOfflineDownloadProgress.completed}/${desktopInitialOfflineDownloadProgress.total}`;
+    status = "downloading";
+  } else if (aggregate.conflicts > 0) {
+    text = `同步冲突 ${aggregate.conflicts}`;
+    status = "attention";
+  } else if (aggregate.pendingMutations > 0 || aggregate.rejected > 0) {
+    text = `待同步 ${aggregate.pendingMutations + aggregate.rejected}`;
+    status = "attention";
+  } else if (aggregate.works > 0) {
+    text = `已离线 ${aggregate.works} 部`;
+    status = "ready";
+  }
+  button.dataset.status = status;
+  button.title = `离线同步：${text}，点击查看详情`;
