+    const summary = await desktopWorkspaceController.store.statusSummary(workId);
+    badge.textContent = summary.conflicts > 0
+      ? `Desktop · ${summary.conflicts} 项冲突`
+      : summary.pending + summary.syncing > 0
+        ? `Desktop · ${summary.pending + summary.syncing} 项待同步`
+        : work.status === "read-only"
+          ? "Desktop · 只读"
+          : "Desktop · 离线可用";
+  }
