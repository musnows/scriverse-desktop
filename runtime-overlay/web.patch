+async function maybeOfferInitialDesktopOfflineDownload() {
+  if (desktopOfflineMode || !isDesktopWorkspaceRuntime()) return null;
+  if (desktopInitialOfflineDownloadTask) return desktopInitialOfflineDownloadTask;
+  desktopInitialOfflineDownloadTask = (async () => {
+    const controller = await ensureDesktopWorkspace();
+    if (!controller) return null;
+    let bootstrap = await controller.store.getInitialOfflineDownloadState();
+    if (!bootstrap) {
+      const accepted = await confirmToast(
+        "是否立即将此 Server 的全部可离线作品保存到本机？远端 AI 设置不会下载。",
+        { title: "首次连接 Server", confirmLabel: "立即离线全部", cancelLabel: "暂不离线" }
+      );
+      bootstrap = await controller.store.setInitialOfflineDownloadState({
+        decision: accepted ? "accepted" : "declined",
+        completed: !accepted
+      });
+      if (!accepted) {
+        toast("已保留在线使用；之后仍可在离线同步中心逐部下载");
+        return bootstrap;
+      }
+    }
+    if (bootstrap.decision !== "accepted" || bootstrap.completed) return bootstrap;
+    const dismiss = persistentToast("正在保存全部可离线作品");
+    try {
+      const works = await apiAllPages("/api/works", 100);
+      desktopInitialOfflineDownloadProgress = { completed: 0, total: works.length };
+      await renderDesktopSyncStatus();
+      const result = await controller.downloadAllWorks(works, {
+        onProgress: async (progress) => {
+          desktopInitialOfflineDownloadProgress = {
+            completed: progress.downloaded + progress.alreadyCached + progress.skipped.length + progress.failed.length,
+            total: progress.total
+          };
+          await renderDesktopSyncStatus();
+        }
+      });
+      const completed = result.failed.length === 0;
+      await controller.store.setInitialOfflineDownloadState({ decision: "accepted", completed });
+      await renderDesktopShelfBadges();
+      if (!completed) {
+        toast(`全量离线已完成 ${result.downloaded + result.alreadyCached}/${result.total} 部，${result.failed.length} 部将在下次连接继续`, "error");
+      } else if (result.skipped.length > 0) {
+        toast(`已离线 ${result.downloaded + result.alreadyCached} 部作品；${result.skipped.length} 部尚未获得离线权限`);
+      } else {
+        toast(`已离线全部 ${result.total} 部作品`);
+      }
+      return result;
+    } catch (error) {
+      toast(`全量离线未完成：${error.message}；下次连接会继续`, "error");
+      return null;
+    } finally {
+      desktopInitialOfflineDownloadProgress = null;
+      await renderDesktopSyncStatus();
+      dismiss();
+    }
+  })().finally(() => {
+    desktopInitialOfflineDownloadTask = null;
+  });
+  return desktopInitialOfflineDownloadTask;
+}
